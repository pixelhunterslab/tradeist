# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# ".env" git'e girmez. Asla commit etme, içeriğini hiçbir yere yapıştırma.
#
# Freqtrade, FREQTRADE__BOLUM__ANAHTAR adındaki her değişkeni okur ve
# user_data/config.json'daki aynı ayarın yerine onu kullanır.

# ---- Binance API (USD-M Vadeli) ----
# Backtest / sadece herkese açık veriyle dry-run için boş bırakılabilir.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# ---- Telegram (ana bot + haftalık rapor) ----
# Token: Telegram'da @BotFather -> /newbot. Chat id: README'ye bak.
# Doldurduktan sonra ENABLED=true yap.
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# ---- (İsteğe bağlı) ComboTrend gözlem botu için Telegram ----
# Aynı token iki botta çalışmaz; ayrı bir bot (@BotFather) gerekir. Boşsa kapalı kalır.
# Chat id aynı kalabilir.
COMBO_TELEGRAM_ENABLED=false
COMBO_TELEGRAM_TOKEN=

# ---- FreqUI / REST API girişi (ZORUNLU) ----
# FreqUI'ye bu kullanıcı adı/şifreyle girilir. Diğer ikisi rastgele uzun metin olmalı
# (JWT_SECRET_KEY EN AZ 32 karakter; boş veya kısa olursa bot başlamaz).
# Windows PowerShell'de 40 karakterlik rastgele metin üretip panoya kopyalamak için
# (sonra = işaretinden hemen sonra Ctrl+V ile yapıştır):
#   -join (1..40 | % {[char]((48..57)+(97..122) | Get-Random)}) | Set-Clipboard
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# ---- Botun çalıştıracağı strateji (Aşama 3 turnuvasında seçildi) ----
STRATEGY=EmaAdxTrend

# ---- Haftalık rapor zamanı (varsayılan: pazartesi 09:00 İstanbul) ----
REPORT_TZ=Europe/Istanbul
REPORT_WEEKDAY=0
REPORT_HOUR=9

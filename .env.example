# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# ".env" git'e girmez. Asla commit etme, içeriğini hiçbir yere yapıştırma.
#
# Freqtrade, FREQTRADE__BOLUM__ANAHTAR adındaki her değişkeni okur ve
# user_data/config.json'daki aynı ayarın yerine onu kullanır.

# ---- Binance API (USD-M Vadeli) ----
# Backtest / sadece herkese açık veriyle dry-run için boş bırakılabilir.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# ---- Telegram (Aşama 4'te açılacak) ----
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# ---- FreqUI / REST API girişi (Aşama 4'te açılacak) ----
# Rastgele değerler üret, örn.:  python -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# ---- Botun çalıştıracağı strateji (Aşama 3 turnuvasında seçildi) ----
STRATEGY=EmaAdxTrend

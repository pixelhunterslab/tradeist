# Copy this file to ".env" and fill in your values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# ".env" is git-ignored. Never commit it, never paste its contents anywhere.
#
# Freqtrade reads any variable named FREQTRADE__SECTION__KEY and uses it to
# override the matching setting in user_data/config.json.

# ---- Binance API (USD-M Futures) ----
# Leave empty for backtesting / dry-run with public data only.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# ---- Telegram (enabled in Phase 4) ----
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# ---- FreqUI / REST API login (enabled in Phase 4) ----
# Generate random values, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# ---- Which strategy the bot runs (chosen in Phase 3) ----
STRATEGY=

{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "futures-swing-bot",

    // ===== Güvenlik anahtarı =====
    // true = sanal işlem (gerçek emir yok). Aşama 5'e kadar true kalır.
    "dry_run": true,
    "dry_run_wallet": 100,

    // ===== Futures / margin =====
    "trading_mode": "futures",
    "margin_mode": "isolated",
    // Freqtrade'in kendi koruması: stop, likidasyon fiyatından en az
    // giriş->likidasyon mesafesinin %30'u kadar uzakta tutulur.
    "liquidation_buffer": 0.3,

    // ===== Sermaye =====
    "stake_currency": "USDT",
    // Gerçek pozisyon büyüklüğünü strateji her işlemde hesaplar
    // (riske göre boyutlama, aşağıda "swing_risk"). "unlimited" buna izin verir.
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 3,
    "fiat_display_currency": "USD",

    // ===== Kendi risk kurallarımız (ortak strateji temel sınıfı okur) =====
    // Her değer .env'den de değiştirilebilir, örn.
    //   FREQTRADE__SWING_RISK__LEVERAGE=3
    "swing_risk": {
        "leverage": 5,
        "max_leverage": 5,
        "max_loss_per_trade_pct_of_balance": 5.0,
        "max_margin_per_trade_pct_of_balance": 25.0,
        "atr_period": 14,
        "atr_stop_multiplier": 2.5
    },

    // ===== Emirler =====
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        // Stop Binance'in üzerinde durur; bot kapalıyken bile seni korur.
        "stoploss_on_exchange": true,
        "stoploss_on_exchange_interval": 60,
        // Mark fiyatıyla tetiklenir (Binance likidasyonda da bunu kullanır),
        // böylece son işlem fiyatındaki kısa iğneler stopu tetiklemez.
        "stoploss_price_type": "mark"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {"enabled": false, "bids_to_ask_delta": 1}
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "cancel_open_orders_on_exit": false,

    // ===== Borsa & coinler =====
    // API anahtarı/secret .env'den gelir (FREQTRADE__EXCHANGE__KEY / __SECRET).
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        // check_pairs.py sonucu (26.10.2026): BTC (min emir çok büyük), LINK, AVAX,
        // LTC (düşük hacim) elendi.
        "pair_whitelist": [
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "BNB/USDT:USDT",
            "DOGE/USDT:USDT",
            "ADA/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [{"method": "StaticPairList"}],

    // ===== Bildirimler / arayüz (Aşama 4'te ayarlanacak) =====
    "telegram": {"enabled": false, "token": "", "chat_id": ""},

    "dataformat_ohlcv": "feather",
    "internals": {"process_throttle_secs": 5}
}

{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "futures-swing-bot",

    // ===== Safety switch =====
    // true  = paper trading (no real orders). This stays true until Phase 5.
    "dry_run": true,
    "dry_run_wallet": 100,

    // ===== Futures / margin =====
    "trading_mode": "futures",
    "margin_mode": "isolated",
    // Freqtrade's own guard: the stoploss is kept at least 30% of the
    // entry->liquidation distance away from the liquidation price.
    "liquidation_buffer": 0.3,

    // ===== Capital =====
    "stake_currency": "USDT",
    // Real position size is calculated per trade by the strategy
    // (risk-based sizing, see "swing_risk" below). "unlimited" just lets it.
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 3,
    "fiat_display_currency": "USD",

    // ===== Our own risk rules (read by the shared strategy base class) =====
    // Each value can also be overridden from .env, e.g.
    //   FREQTRADE__SWING_RISK__LEVERAGE=3
    "swing_risk": {
        "leverage": 5,
        "max_leverage": 5,
        "max_loss_per_trade_pct_of_balance": 5.0,
        "max_margin_per_trade_pct_of_balance": 25.0,
        "atr_period": 14,
        "atr_stop_multiplier": 2.5
    },

    // ===== Orders =====
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        // Stop lives on Binance, so it protects you even if the bot is offline.
        "stoploss_on_exchange": true,
        "stoploss_on_exchange_interval": 60,
        // Trigger on mark price (same price Binance uses for liquidation),
        // so short wicks on the last-traded price don't trigger it.
        "stoploss_price_type": "mark"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {"enabled": false, "bids_to_ask_delta": 1}
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "cancel_open_orders_on_exit": false,

    // ===== Exchange & pairs =====
    // API key/secret come from .env (FREQTRADE__EXCHANGE__KEY / __SECRET).
    // Final pair list is set after running user_data/tools/check_pairs.py.
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "BNB/USDT:USDT",
            "DOGE/USDT:USDT",
            "ADA/USDT:USDT",
            "LINK/USDT:USDT",
            "AVAX/USDT:USDT",
            "LTC/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [{"method": "StaticPairList"}],

    // ===== Notifications / UI (configured in Phase 4) =====
    "telegram": {"enabled": false, "token": "", "chat_id": ""},

    "dataformat_ohlcv": "feather",
    "internals": {"process_throttle_secs": 5}
}

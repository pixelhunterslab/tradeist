{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "futures-swing-bot",

    // ===== Güvenlik anahtarı =====
    // true = sanal işlem (gerçek emir yok). Aşama 5'e kadar true kalır.
    "dry_run": true,
    "dry_run_wallet": 100,
    // Bot (yeniden) başlayınca doğrudan çalışsın; aksi halde /start beklerdi.
    "initial_state": "running",

    // ===== Futures / margin =====
    "trading_mode": "futures",
    "margin_mode": "isolated",
    // Freqtrade'in kendi koruması: stop, likidasyon fiyatından en az
    // giriş->likidasyon mesafesinin %30'u kadar uzakta tutulur.
    "liquidation_buffer": 0.3,

    // ===== Sermaye =====
    "stake_currency": "USDT",
    // Gerçek pozisyon büyüklüğünü strateji her işlemde hesaplar
    // (riske göre boyutlama, aşağıda "swing_risk"). "unlimited" buna izin verir.
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 3,
    "fiat_display_currency": "USD",

    // ===== Kendi risk kurallarımız (ortak strateji temel sınıfı okur) =====
    // Her değer .env'den de değiştirilebilir, örn.
    //   FREQTRADE__SWING_RISK__LEVERAGE=3
    "swing_risk": {
        "leverage": 5,
        "max_leverage": 5,
        "max_loss_per_trade_pct_of_balance": 5.0,
        "max_margin_per_trade_pct_of_balance": 25.0,
        "atr_period": 14,
        "atr_stop_multiplier": 3.0,   // Aşama 3 turnuvası sonucu
        // Stop en az fiyatın bu %'si kadar uzakta olur (veri boşluklarına karşı).
        "min_stop_distance_pct": 1.0,
        // Çıkış: "trailing" = kâr 1R'ye ulaşınca stop fiyatı ATR mesafesinden takip eder
        //        "fixed_tp" = fiyat take_profit_rr x risk kadar gidince kâr al
        "exit_mode": "trailing",
        "take_profit_rr": 2.0,
        "trail_activation_rr": 1.0,
        "trail_atr_multiplier": 3.0
    },

    // ===== Korumalar (Freqtrade protections; strateji bu değerleri okur) =====
    // Botun canlıda da backtestte de aynı korumalarla çalışması için burada.
    "swing_protections": {
        // Bir coinde işlem kapanınca o coinde 4 saat yeni işlem yok.
        "cooldown_minutes": 240,
        // 24 saatte 3 stop olursa 12 saat hiç yeni işlem açma.
        "stoploss_guard": {"lookback_minutes": 1440, "trade_limit": 3, "stop_minutes": 720},
        // Son 30 günde hesap %25'ten fazla düşerse 1 hafta yeni işlem açma.
        "max_drawdown": {"lookback_minutes": 43200, "max_drawdown_pct": 25, "trade_limit": 1,
                         "stop_minutes": 10080},
        // Son 14 günde 3+ işlemde zararda olan coini 2 gün kilitle.
        "low_profit_pairs": {"lookback_minutes": 20160, "trade_limit": 3, "required_profit": 0.0,
                             "stop_minutes": 2880}
    },

    // ===== Emirler =====
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        // Stop Binance'in üzerinde durur; bot kapalıyken bile seni korur.
        "stoploss_on_exchange": true,
        "stoploss_on_exchange_interval": 60,
        // Mark fiyatıyla tetiklenir (Binance likidasyonda da bunu kullanır),
        // böylece son işlem fiyatındaki kısa iğneler stopu tetiklemez.
        "stoploss_price_type": "mark"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {"enabled": false, "bids_to_ask_delta": 1}
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "cancel_open_orders_on_exit": false,

    // ===== Borsa & coinler =====
    // API anahtarı/secret .env'den gelir (FREQTRADE__EXCHANGE__KEY / __SECRET).
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        // check_pairs.py sonucu (26.10.2026): BTC (min emir çok büyük), LINK, AVAX,
        // LTC (düşük hacim) elendi.
        "pair_whitelist": [
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "BNB/USDT:USDT",
            "DOGE/USDT:USDT",
            "ADA/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [{"method": "StaticPairList"}],

    // ===== Telegram =====
    // Token ve chat id .env'den gelir. Açmak için .env: FREQTRADE__TELEGRAM__ENABLED=true
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": "",
        "notification_settings": {
            "status": "on",              // bot başladı / durdu
            "warning": "on",             // hatalar ve uyarılar
            "startup": "on",
            "entry": "on",               // işlem açılıyor
            "entry_fill": "on",          // işlem açıldı (dolum)
            "entry_cancel": "on",
            "exit": "on",                // işlem kapanıyor (stop dahil)
            "exit_fill": "on",           // işlem kapandı; stop_loss sebebi mesajda yazar
            "exit_cancel": "on",
            "protection_trigger": "on",
            "protection_trigger_global": "on",
            "liquidation_warning": "on"
        },
        "reload": true,
        "keyboard": [
            ["/status", "/profit", "/balance"],
            ["/daily", "/weekly", "/performance"],
            ["/stopentry", "/stop", "/start", "/help"]
        ]
    },

    // ===== FreqUI web arayüzü + REST API =====
    // Sadece bu bilgisayardan erişilir (docker-compose 127.0.0.1'e bağlar).
    // Kullanıcı adı/şifre ve gizli anahtarlar (jwt_secret_key, ws_token) .env'den gelir.
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "CORS_origins": ["http://localhost:8080", "http://127.0.0.1:8080"],
        "username": "",
        "password": ""
    },

    "dataformat_ohlcv": "feather",
    "internals": {"process_throttle_secs": 5}
}
